{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ctc:layout:page-spec:2.0.0",
  "title": "CTC PageSpec (L01~L08)",
  "description": "L01～L08 通用页面布局规范输入 Schema。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "2.0.0"
    },
    "templateId": {
      "enum": [
        "L01_STANDARD_TABLE_PAGE",
        "L02_SIDEBAR_TREE_SPLIT",
        "L03_MASTER_DETAIL_SPLIT",
        "L04_GIS_HUD_DASHBOARD",
        "L05_DUAL_PANE_REVIEW",
        "L06_GRID_DASHBOARD",
        "L07_SECTION_ANCHOR_FLOW",
        "L08_STEP_WIZARD_FUNNEL"
      ]
    },
    "mode": {
      "enum": [
        "layout",
        "page"
      ],
      "description": "输出模式：仅布局(layout) 或 业务页面(page)。"
    },
    "surface": { "enum": ["embedded", "standalone", "dialog", "drawer"], "description": "当前布局实例的承载区域；页面与每个弹层分别选型" },
    "layoutKey": { "type": "string", "minLength": 1, "description": "通过 data-layout-id 唯一标识同模板的不同实例" },
    "pageTitle": {
      "type": "string",
      "minLength": 1
    },
    "enabledSlots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "main-viewport",
          "filter-bar",
          "toolbar",
          "footer-bar",
          "sidebar-nav",
          "content-body",
          "content-header",
          "content-footer",
          "master-list",
          "detail-body",
          "master-filter",
          "detail-head",
          "detail-actions",
          "canvas-bg",
          "hud-top",
          "hud-left",
          "hud-right",
          "hud-bottom-left",
          "hud-bottom-right",
          "pane-left",
          "pane-right",
          "dashboard-grid",
          "metric-cards",
          "dashboard-toolbar",
          "anchor-nav",
          "sections-stream",
          "profile-header",
          "sticky-actions",
          "step-tracker",
          "stage-viewport",
          "action-rail",
          "step-summary"
        ]
      }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": ["inherit", "light", "dark"],
          "default": "inherit"
        }
      },
      "additionalProperties": false
    },
    "layoutProps": {
      "type": "object",
      "description": "传递给底层布局组件的显式属性",
      "properties": {
        "autoHeight": { "type": "boolean", "description": "L01: 是否自适应高度" },
        "toolbarPlacement": {
          "enum": ["separate", "filter-inline"],
          "description": "L01: 工具栏位置（默认 separate，filter-inline 与筛选同行）"
        },
        "card": {
          "type": "boolean",
          "description": "L01: 是否启用卡片质感承载（浅灰底背景衬托白色卡片与细边框，默认 true）"
        },
        "sidebarWidth": { "type": ["string", "number"], "description": "L02: 侧栏宽度，如 260px" },
        "collapsible": { "type": "boolean", "description": "L02: 侧栏是否可折叠" },
        "masterWidth": { "type": ["string", "number"], "description": "L03: 主栏宽度，如 340px" },
        "theme": { "enum": ["dark", "light"], "description": "L04: HUD 主题" },
        "leftWidth": { "type": ["string", "number"], "description": "L05: 左栏宽度，如 45%" },
        "gap": { "type": ["string", "number"], "description": "L05/L06: 栅格/栏间距" },
        "scrollable": { "type": "boolean", "description": "L06/L07: 是否启用根容器滚动" },
        "anchorWidth": { "type": ["string", "number"], "description": "L07: 锚点导航栏宽度" },
        "activeStep": { "type": "integer", "minimum": 0, "description": "L08: 当前激活步骤索引" }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "description": "L01 主视口配置 (表格组件或报表配置)"
    },
    "filters": {
      "type": "array",
      "description": "L01 筛选项列表"
    },
    "toolbar": {
      "type": "object",
      "description": "操作工具栏配置"
    },
    "footer": {
      "type": "object",
      "description": "底部操作栏配置"
    },
    "pagination": {
      "type": "object",
      "description": "分页栏配置"
    },
    "sidebar": {
      "type": "object",
      "description": "L02 侧栏导航/树配置"
    },
    "content": {
      "type": "object",
      "description": "L02 右侧主体内容配置"
    },
    "master": {
      "type": "object",
      "description": "L03 主列表卡片流配置"
    },
    "detail": {
      "type": "object",
      "description": "L03 从属详情配置"
    },
    "masterFilter": {
      "type": "object",
      "description": "L03 主列表筛选配置"
    },
    "detailActions": {
      "type": "object",
      "description": "L03 详情操作条配置"
    },
    "map": {
      "type": "object",
      "description": "L04 地图底图配置"
    },
    "panels": {
      "type": "array",
      "description": "L04 悬浮面板配置",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "enum": [
              "hud-top",
              "hud-left",
              "hud-right",
              "hud-bottom-left",
              "hud-bottom-right"
            ],
            "description": "必须是 L04 允许的合法 HUD 插槽"
          },
          "title": { "type": "string" }
        },
        "required": ["slot"],
        "additionalProperties": false
      }
    },
    "legend": {
      "type": "object",
      "description": "L04 图例配置"
    },
    "mapTools": {
      "type": "object",
      "description": "L04 地图空间工具配置"
    },
    "leftPane": {
      "type": "object",
      "description": "L05 左栏证据/详情配置"
    },
    "rightPane": {
      "type": "object",
      "description": "L05 右栏流转/审批配置"
    },
    "actions": {
      "type": "object",
      "description": "L05 底部操作配置"
    },
    "grid": {
      "type": "object",
      "description": "L06 看板网格卡片配置",
      "properties": {
        "columns": { "const": 12, "description": "L06 固定使用 12 栅格" },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "span": { "type": "integer", "minimum": 1, "maximum": 12 },
              "height": { "type": ["string", "number"] }
            },
            "required": ["title", "span"],
            "additionalProperties": false
          }
        }
      },
      "required": ["cards"],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "description": "L06 顶部核心 KPI 指标卡"
    },
    "sections": {
      "type": "array",
      "description": "L07 长卷章节内容流配置"
    },
    "profileHeader": {
      "type": "object",
      "description": "L07 实体信息头部概要"
    },
    "stickyActions": {
      "type": "object",
      "description": "L07 吸底操作条配置"
    },
    "steps": {
      "type": "array",
      "description": "L08 步骤阶段列表",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "icon": { "type": "string" }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "stepSummary": {
      "type": "object",
      "description": "L08 步骤引导摘要"
    },
    "actionRail": {
      "type": "object",
      "description": "L08 底部动作导轨配置"
    }
  },
  "required": [
    "contractVersion",
    "templateId",
    "mode"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": { "const": "layout" }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "pageTitle": false,
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false
        }
      },
      "else": {
        "required": ["pageTitle"]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L01_STANDARD_TABLE_PAGE" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "autoHeight": { "type": "boolean" },
              "toolbarPlacement": { "enum": ["separate", "filter-inline"] },
              "card": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["main-viewport", "filter-bar", "toolbar", "footer-bar"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["viewport"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L02_SIDEBAR_TREE_SPLIT" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "footer": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "sidebarWidth": { "type": ["string", "number"] },
              "collapsible": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["sidebar-nav", "content-body", "content-header", "content-footer"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["sidebar", "content"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L03_MASTER_DETAIL_SPLIT" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "masterWidth": { "type": ["string", "number"] }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["master-list", "detail-body", "master-filter", "detail-head", "detail-actions"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["master", "detail"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L04_GIS_HUD_DASHBOARD" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "theme": { "enum": ["dark", "light"] }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["canvas-bg", "hud-top", "hud-left", "hud-right", "hud-bottom-left", "hud-bottom-right"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["map"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L05_DUAL_PANE_REVIEW" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "leftWidth": { "type": ["string", "number"] },
              "gap": { "type": ["string", "number"] }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["pane-left", "pane-right"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["leftPane", "rightPane", "surface"], "properties": {"surface": {"enum": ["dialog", "drawer"]}} }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L06_GRID_DASHBOARD" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "gap": { "type": ["string", "number"] },
              "scrollable": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["dashboard-grid", "metric-cards", "dashboard-toolbar"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["grid"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L07_SECTION_ANCHOR_FLOW" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "steps": false,
          "stepSummary": false,
          "actionRail": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "anchorWidth": { "type": ["string", "number"] },
              "scrollable": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["anchor-nav", "sections-stream", "profile-header", "sticky-actions"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["sections"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "templateId": { "const": "L08_STEP_WIZARD_FUNNEL" } },
        "required": ["templateId"]
      },
      "then": {
        "properties": {
          "viewport": false,
          "filters": false,
          "toolbar": false,
          "footer": false,
          "pagination": false,
          "sidebar": false,
          "content": false,
          "master": false,
          "detail": false,
          "masterFilter": false,
          "detailActions": false,
          "map": false,
          "panels": false,
          "legend": false,
          "mapTools": false,
          "leftPane": false,
          "rightPane": false,
          "actions": false,
          "grid": false,
          "metrics": false,
          "sections": false,
          "profileHeader": false,
          "stickyActions": false,
          "layoutProps": {
            "type": "object",
            "properties": {
              "activeStep": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "enabledSlots": {
            "items": {
              "enum": ["step-tracker", "stage-viewport", "action-rail", "step-summary"]
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "page" } }, "required": ["mode"] },
            "then": { "required": ["steps"] }
          }
        ]
      }
    }
  ]
}
